{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",

  "description": [
    "PISA squid plot for the Drosophila sog enhancer (Figure 2c)",
    "Links connect influential input bases to affected ATAC-seq output positions. Positive effects are red and negative effects are blue."
  ],

  "scales": {
    "x": { "domain": [15646349, 15647550], "zoom": true }
  },

  "resolve": { "scale": { "x": "shared" }, "axis": { "x": "shared" } },
  "spacing": 3,

  "vconcat": [
    {
      "name": "prediction",
      "title": "Predicted bias-minimized ATAC-seq profile",
      "height": 80,
      "data": {
        "url": "../output/fig2cd-atac-tracks.parquet",
        "format": { "type": "parquet" }
      },
      "transform": [
        { "type": "filter", "expr": "datum.track == 'prediction'" },
        { "type": "formula", "expr": "datum.position + 1", "as": "end" }
      ],
      "mark": { "type": "rect", "color": "#30343b", "minOpacity": 1 },
      "encoding": {
        "x": {
          "field": "position",
          "type": "index",
          "title": "chrX position (dm6)"
        },
        "x2": { "field": "end" },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Prediction",
          "scale": { "zero": true }
        },
        "y2": { "datum": 0 },
        "tooltip": [
          { "field": "position", "title": "Output position" },
          { "field": "value", "title": "Prediction", "format": ".4g" }
        ]
      }
    },
    {
      "name": "pisa-links",
      "title": "PISA input-to-output effects",
      "height": 220,
      "data": {
        "url": "../output/fig2c-atac-links.parquet",
        "format": { "type": "parquet" }
      },
      "transform": [
        { "type": "formula", "expr": "abs(datum.effect)", "as": "absEffect" }
      ],
      "mark": {
        "type": "link",
        "linkShape": "line",
        "minPickingSize": 2
      },
      "encoding": {
        "x": {
          "field": "source",
          "type": "index",
          "title": "chrX position (dm6)"
        },
        "x2": { "field": "target" },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": { "domain": [0, 1] },
          "axis": null
        },
        "y2": { "datum": 1 },
        "color": {
          "field": "effect",
          "type": "quantitative",
          "scale": {
            "domain": [-0.216404, 0, 0.216404],
            "range": ["#2166ac", "#eeeeee", "#b2182b"],
            "clamp": true
          },
          "legend": { "title": "PISA effect (log2 fold change)" }
        },
        "size": {
          "field": "absEffect",
          "type": "quantitative",
          "scale": {
            "domain": [0.043281, 0.216404],
            "range": [0.25, 2.5],
            "clamp": true
          },
          "legend": null
        },
        "opacity": { "value": 0.55 },
        "tooltip": [
          { "field": "source", "title": "Input position" },
          { "field": "target", "title": "Output position" },
          {
            "field": "effect",
            "title": "PISA effect (log2 fold change)",
            "format": ".4f"
          }
        ]
      }
    },
    {
      "name": "importance",
      "title": "Input-base contribution",
      "height": 60,
      "data": {
        "url": "../output/fig2cd-atac-tracks.parquet",
        "format": { "type": "parquet" }
      },
      "transform": [
        { "type": "filter", "expr": "datum.track == 'importance'" },
        { "type": "formula", "expr": "datum.position + 1", "as": "end" }
      ],
      "mark": { "type": "rect", "color": "#4c78a8", "minOpacity": 1 },
      "encoding": {
        "x": {
          "field": "position",
          "type": "index",
          "title": "chrX position (dm6)"
        },
        "x2": { "field": "end" },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Contribution",
          "scale": { "zero": true }
        },
        "y2": { "datum": 0 },
        "tooltip": [
          { "field": "position", "title": "Input position" },
          { "field": "value", "title": "Contribution", "format": ".4g" }
        ]
      }
    },
    {
      "name": "motifs",
      "title": "Motif calls",
      "height": 22,
      "data": {
        "url": "../output/fig2cd-atac-motifs.parquet",
        "format": { "type": "parquet" }
      },
      "mark": { "type": "rect", "minOpacity": 1 },
      "encoding": {
        "x": {
          "field": "start",
          "type": "index",
          "title": "chrX position (dm6)"
        },
        "x2": { "field": "end" },
        "color": {
          "field": "name",
          "type": "nominal",
          "scale": { "scheme": "tableau10" },
          "legend": { "title": "Motif" }
        },
        "tooltip": [
          { "field": "name", "title": "Motif" },
          { "field": "start", "title": "Start" },
          { "field": "end", "title": "End" },
          { "field": "strand", "title": "Strand" },
          { "field": "score", "title": "Score" }
        ]
      }
    }
  ],

  "config": {
    "legend": { "orient": "top" },
    "view": { "stroke": "#d8d8d8", "strokeWidth": 1 }
  }
}

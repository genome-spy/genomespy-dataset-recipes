{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",

  "description": [
    "PISA squid plot for the Drosophila sog enhancer (Figure 2c)",
    "Links connect influential input bases to affected ATAC-seq output positions. Positive effects are red and negative effects are blue."
  ],

  "params": [
    {
      "name": "pisaRegion",
      "persist": false,
      "description": "Shift-drag across the tracks to focus links with either endpoint in the selected interval.",
      "select": {
        "type": "interval",
        "encodings": ["x"],
        "extent": "container",
        "on": "mousedown[event.shiftKey]",
        "clear": "dblclick",
        "zoom": false,
        "mark": {
          "stroke": "#777777",
          "strokeOpacity": 0.65,
          "strokeWidth": 1,
          "fill": "#999999",
          "fillOpacity": 0.01,
          "shadowBlur": 8,
          "shadowColor": "#777777",
          "shadowOpacity": 0.35,
          "clip": false,
          "measure": "inside"
        }
      }
    }
  ],

  "scales": {
    "x": { "domain": [15646649, 15647250], "zoom": true }
  },

  "resolve": {
    "scale": { "x": "shared" },
    "axis": { "x": "shared" },
    "legend": { "color": "collected" }
  },
  "padding": { "top": 8, "right": 30, "bottom": 8, "left": 10 },
  "spacing": 0,

  "vconcat": [
    {
      "name": "prediction",
      "title": {
        "text": "Accessibility",
        "style": "overlay-title"
      },
      "height": { "grow": 0.16 },
      "data": {
        "url": "../output/fig2cd-atac-tracks.parquet",
        "format": { "type": "parquet" }
      },
      "transform": [
        { "type": "filter", "expr": "datum.track == 'prediction'" },
        { "type": "formula", "expr": "datum.position + 1", "as": "end" }
      ],
      "mark": { "type": "rect", "color": "#332288", "minOpacity": 1 },
      "encoding": {
        "x": {
          "field": "position",
          "type": "index",
          "title": "dm6 chrX"
        },
        "x2": { "field": "end" },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": { "zero": true },
          "axis": null
        },
        "y2": { "datum": 0 },
        "tooltip": [
          { "field": "position", "title": "Output position" },
          { "field": "value", "title": "Prediction", "format": ".4g" }
        ]
      }
    },
    {
      "resolve": { "scale": { "color": "independent" } },
      "layer": [
        {
          "name": "pisa-links",
          "data": {
            "url": "../output/fig2c-atac-links.parquet",
            "format": { "type": "parquet" }
          },
          "transform": [
            {
              "type": "formula",
              "expr": "abs(datum.effect)",
              "as": "absEffect"
            }
          ],
          "params": [
            {
              "name": "pisaLinkHover",
              "select": {
                "type": "point",
                "on": "pointerover"
              },
              "persist": false
            }
          ],
          "mark": {
            "type": "link",
            "linkShape": "diagonal",
            "orient": "vertical",
            "size": 1.5,
            "minPickingSize": 2
          },
          "encoding": {
            "order": {
              "condition": {
                "test": {
                  "param": { "or": ["pisaLinkHover", "pisaRegion"] },
                  "empty": false
                },
                "value": 1
              },
              "value": 0
            },
            "x": {
              "field": "source",
              "type": "index",
              "title": "dm6 chrX",
              "buildIndex": false
            },
            "x2": { "field": "target" },
            "y": {
              "datum": 0,
              "type": "quantitative",
              "scale": { "domain": [0, 1] },
              "axis": null
            },
            "y2": { "datum": 1 },
            "color": {
              "condition": {
                "test": {
                  "param": { "or": ["pisaLinkHover", "pisaRegion"] },
                  "empty": true
                },
                "field": "effect",
                "type": "quantitative",
                "scale": {
                  "domain": [
                    -0.216404, -0.173123, -0.129843, -0.086562, -0.043281, 0,
                    0.043281, 0.086562, 0.129843, 0.173123, 0.216404
                  ],
                  "range": [
                    "#053061",
                    "#2166ac",
                    "#4393c3",
                    "#92c5de",
                    "#d1e5f0",
                    "#ffffff",
                    "#fddbc7",
                    "#f4a582",
                    "#d6604d",
                    "#b2182b",
                    "#67001f"
                  ],
                  "clamp": true
                },
                "legend": {
                  "title": "PISA (log2(fc))",
                  "orient": "left",
                  "direction": "vertical",
                  "gradientLength": 84,
                  "gradientThickness": 18,
                  "gradientStrokeColor": "#777777",
                  "gradientStrokeWidth": 0.5,
                  "values": [-0.2, 0, 0.2]
                }
              },
              "value": "#d8dbe0"
            },
            "opacity": {
              "condition": {
                "test": {
                  "param": { "or": ["pisaLinkHover", "pisaRegion"] },
                  "empty": true
                },
                "field": "absEffect",
                "type": "quantitative",
                "scale": {
                  "domain": [0, 0.216404],
                  "range": [0, 1],
                  "clamp": true
                },
                "legend": null
              },
              "value": 0.1
            },
            "tooltip": [
              { "field": "source", "title": "Input position" },
              { "field": "target", "title": "Output position" },
              {
                "field": "effect",
                "title": "PISA effect (log2 fold change)",
                "format": ".4f"
              }
            ]
          }
        },
        {
          "name": "motifs",
          "data": {
            "url": "../output/fig2cd-atac-motifs.parquet",
            "format": { "type": "parquet" }
          },
          "transform": [
            {
              "type": "formula",
              "expr": "datum.name == 'm1bp' ? 'M1bp' : datum.name == 'gaga' ? 'Gaga' : 'Zelda'",
              "as": "motifLabel"
            }
          ],
          "mark": { "type": "rect", "minOpacity": 1 },
          "encoding": {
            "x": {
              "field": "start",
              "type": "index",
              "title": "dm6 chrX"
            },
            "x2": { "field": "end" },
            "y": { "value": { "expr": "4 / height" } },
            "y2": { "value": { "expr": "20 / height" } },
            "color": {
              "field": "motifLabel",
              "type": "nominal",
              "scale": {
                "domain": ["M1bp", "Gaga", "Zelda"],
                "range": ["#bbcc33", "#44bb99", "#99ddff"]
              },
              "legend": {
                "orient": "left",
                "direction": "vertical",
                "symbolOpacity": 1
              }
            },
            "tooltip": [
              { "field": "motifLabel", "title": "Motif" },
              { "field": "start", "title": "Start" },
              { "field": "end", "title": "End" },
              { "field": "strand", "title": "Strand" },
              { "field": "score", "title": "Score" }
            ]
          }
        }
      ]
    },
    {
      "name": "importance",
      "title": {
        "text": "Contribution score",
        "style": "overlay-title"
      },
      "height": { "grow": 0.16 },
      "data": {
        "url": "../output/fig2cd-atac-tracks.parquet",
        "format": { "type": "parquet" }
      },
      "transform": [
        { "type": "filter", "expr": "datum.track == 'importance'" },
        { "type": "formula", "expr": "datum.position + 1", "as": "end" }
      ],
      "mark": { "type": "rect", "color": "#332288", "minOpacity": 1 },
      "encoding": {
        "x": {
          "field": "position",
          "type": "index",
          "title": "dm6 chrX"
        },
        "x2": { "field": "end" },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": { "zero": true },
          "axis": null
        },
        "y2": { "datum": 0 },
        "tooltip": [
          { "field": "position", "title": "Input position" },
          { "field": "value", "title": "Contribution", "format": ".4g" }
        ]
      }
    }
  ],

  "config": {
    "axis": { "domain": false },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "layout": { "left": { "anchor": "middle", "wrap": false } }
    },
    "legendTrack": { "style": null },
    "title": { "fontSize": 12, "fontWeight": "normal", "offset": 2 },
    "view": { "stroke": "transparent", "strokeWidth": 0 }
  }
}

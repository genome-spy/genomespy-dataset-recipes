{
  "title": "hg19 RefSeq gene bodies, chromosome 1",
  "data": {
    "url": "../output/refseq-gene-bodies.csv.gz",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "type": "filter",
      "expr": "datum.assembly === 'hg19' && datum.chrom === 'chr1'"
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "start",
      "type": "quantitative"
    },
    "x2": {
      "field": "end"
    },
    "y": {
      "field": "strand",
      "type": "nominal"
    }
  }
}

{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/app/dist/schema.json",

  "name": "copy-ratios",
  "title": "Copy ratios",
  "description": "Segmented MCCA copy-number ratio data. Values come from the source LOG2FC field and are shown as log2 copy-ratio heatmap values.",

  "configurableVisibility": true,

  "data": {
    "url": "../output/processed/copy-ratios.parquet",
    "format": {
      "type": "parquet"
    }
  },

  "mark": {
    "type": "rect",
    "minOpacity": 1.0,
    "minWidth": 1.0
  },

  "encoding": {
    "sample": {
      "field": "sample"
    },
    "x": {
      "chrom": "chrom",
      "pos": "start",
      "type": "locus",
      "axis": {
        "orient": "bottom",
        "grid": false,
        "chromGrid": true,
        "chromGridDash": [3, 3],
        "chromGridColor": "lightgray"
      }
    },
    "x2": {
      "chrom": "chrom",
      "pos": "end"
    },
    "color": {
      "type": "quantitative",
      "field": "log2fc",
      "scale": {
        "domain": [-3, -1.5, 0, 1.5],
        "range": ["#002540", "#0050f8", "#f6f6f6", "#ff3000"],
        "clamp": true
      },
      "description": "Negative values indicate relative copy loss, positive values indicate relative copy gain, and the color scale is clamped for readability."
    }
  },

  "aggregateSamples": [
    {
      "name": "copy-ratio-g-score-summary",
      "description": "Aggregated G score summary of copy-ratio gains and losses across samples. Chromosomes X and Y are omitted because recurrent sex-linked losses, especially deep Y deletions and copy-ratio changes on X, would otherwise dominate the summary.",

      "params": [
        {
          "name": "threshold",
          "value": 0.5,
          "bind": {
            "input": "range",
            "min": 0.0,
            "max": 3.0,
            "step": 0.02,
            "name": "Log2 copy-ratio threshold",
            "description": "The minimum absolute log2fc for segments to be included.",
            "debounce": 200
          }
        },
        {
          "name": "limit",
          "value": 1.5,
          "bind": {
            "input": "range",
            "min": 0.1,
            "max": 4.0,
            "step": 0.02,
            "name": "Log2 copy-ratio limit",
            "description": "The maximum absolute value for log2fc. More extreme values are clamped to the given value.",
            "debounce": 200
          }
        }
      ],

      "title": {
        "text": "G score",
        "style": "overlay",
        "fontSize": 10,
        "color": "black"
      },

      "height": 40,
      "visible": false,
      "view": { "stroke": "lightgray" },
      "padding": { "bottom": 4 },

      "transform": [
        {
          "type": "filter",
          "expr": "datum.chrom != 'chrX' && datum.chrom != 'chrY'"
        },
        {
          "type": "filter",
          "expr": "abs(datum.log2fc) > threshold"
        },
        {
          "type": "project",
          "fields": ["sample", "chrom", "start", "end", "log2fc"]
        },
        {
          "type": "formula",
          "expr": "clamp(datum.log2fc, -limit, limit)",
          "as": "log2fc"
        }
      ],

      "encoding": {
        "y": {
          "field": "coverage",
          "type": "quantitative",
          "title": null,
          "axis": null,
          "scale": {
            "nice": true
          }
        }
      },
      "templates": {
        "coverage": {
          "transform": [
            {
              "type": "filter",
              "expr": "log2fcSign * datum.log2fc > 0"
            },
            {
              "type": "coverage",
              "chrom": "chrom",
              "start": "start",
              "end": "end",
              "weight": "log2fc"
            },
            {
              "type": "formula",
              "expr": "datum.coverage / sampleCount",
              "as": "coverage"
            }
          ],
          "mark": {
            "type": "rect",
            "minOpacity": 1,
            "tooltip": null
          },
          "encoding": {
            "color": { "value": { "expr": "color" } }
          }
        }
      },
      "layer": [
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "rule",
            "strokeDash": [1, 3]
          },
          "encoding": {
            "y": { "datum": 0, "type": "quantitative" },
            "x": null,
            "x2": null,
            "color": { "value": "lightgray" }
          }
        },
        {
          "name": "amplification",
          "params": { "log2fcSign": 1, "color": "#e45756" },
          "import": { "template": "coverage" }
        },
        {
          "name": "deletion",
          "params": { "log2fcSign": -1, "color": "#4c78a8" },
          "import": { "template": "coverage" }
        }
      ]
    }
  ]
}

{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/app/dist/schema.json",
  "assembly": "mm10",
  "specId": "ENCODE mouse fetal development H3K27ac tissue tour v2",
  "name": "encode-mouse-fetal-development-mm10",
  "title": "Mouse fetal tissues: H3K27ac and expression",
  "description": [
    "Full-resolution H3K27ac fold-change-over-control signal for 24 biological replicates from forebrain, heart, and limb at E11.5, E12.5, E13.5, and E15.5, restricted to four one-megabase mm10 neighborhoods.",
    "Expression cells show log2(mean TPM + 1) from two bulk RNA-seq biological replicates for the matching tissue-stage. The condition mean is shared across both H3K27ac rows; the assays are condition-matched, not sample-paired.",
    "The included-region track marks where signal exists. Published elements and GENCODE M21 genes are separate annotation tracks so reporter activity, computational predictions, gene expression, and H3K27ac enrichment are not conflated."
  ],
  "bookmarks": {
    "remote": {
      "url": "bookmarks.json",
      "initialBookmark": "Ascl1 — forebrain at E12.5",
      "tour": true,
      "afterTourBookmark": "mEN886 — tissue identity across stages"
    }
  },
  "scales": {
    "x": {
      "domain": [
        { "chrom": "chr10", "pos": 87300000 },
        { "chrom": "chr10", "pos": 87510000 }
      ]
    }
  },
  "spacing": 5,
  "vconcat": [
    {
      "name": "included-regions",
      "title": {
        "text": "Included regions",
        "style": "track-title"
      },
      "description": "Search Ascl1, mEN886, mEN978, or mEN918. An empty track outside these four intervals means no data were retained, not biological inactivity.",
      "height": 22,
      "data": { "url": "../output/regions.tsv" },
      "layer": [
        {
          "mark": { "type": "rect", "color": "#e4eef7", "stroke": "#4e79a7", "strokeWidth": 1 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus", "axis": null },
            "x2": { "chrom": "chrom", "pos": "end" },
            "search": { "field": "name" },
            "tooltip": [
              { "field": "name", "title": "Included region" },
              { "field": "chrom", "title": "Chromosome" },
              { "field": "start", "title": "Start (0-based)" },
              { "field": "end", "title": "End (exclusive)" },
              { "field": "description", "title": "Purpose" }
            ]
          }
        },
        {
          "mark": { "type": "text", "color": "#1f4e79", "fontWeight": "bold", "fontSize": 10, "paddingX": 4 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus" },
            "x2": { "chrom": "chrom", "pos": "end" },
            "text": { "field": "name" }
          }
        }
      ]
    },
    {
      "name": "published-elements",
      "title": {
        "text": "Published elements",
        "style": "track-title"
      },
      "description": "Filled intervals are reporter-tested candidates; outlined intervals are replicated computational enhancer-gene predictions. Hover for the evidence type and target status.",
      "height": 30,
      "data": { "url": "../output/elements.tsv" },
      "layer": [
        {
          "transform": [
            { "type": "filter", "expr": "datum.evidenceType === 'transgenic reporter'" }
          ],
          "mark": { "type": "rect", "opacity": 0.72, "strokeWidth": 1.5 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus", "axis": null },
            "x2": { "chrom": "chrom", "pos": "end" },
            "color": {
              "field": "intendedTissue",
              "type": "nominal",
              "scale": {
                "domain": ["Forebrain", "Heart", "Limb"],
                "range": ["#4e79a7", "#e15759", "#59a14f"]
              },
              "legend": null
            },
            "tooltip": [
              { "field": "name", "title": "Element" },
              { "field": "evidenceType", "title": "Evidence" },
              { "field": "intendedTissue", "title": "Tissue context" },
              { "field": "predictedTarget", "title": "Predicted target" },
              { "field": "sourceEvidence", "title": "Published evidence" },
              { "field": "chrom", "title": "Chromosome" },
              { "field": "start", "title": "Start (0-based)" },
              { "field": "end", "title": "End (exclusive)" }
            ]
          }
        },
        {
          "transform": [
            { "type": "filter", "expr": "datum.evidenceType === 'enhancer-gene prediction'" }
          ],
          "mark": { "type": "rect", "opacity": 0.18, "strokeWidth": 2 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus", "axis": null },
            "x2": { "chrom": "chrom", "pos": "end" },
            "color": {
              "field": "intendedTissue",
              "type": "nominal",
              "scale": {
                "domain": ["Forebrain", "Heart", "Limb"],
                "range": ["#4e79a7", "#e15759", "#59a14f"]
              },
              "legend": null
            },
            "tooltip": [
              { "field": "name", "title": "Element" },
              { "field": "evidenceType", "title": "Evidence" },
              { "field": "predictedTarget", "title": "Predicted target" },
              { "field": "sourceEvidence", "title": "Published evidence" },
              { "field": "chrom", "title": "Chromosome" },
              { "field": "start", "title": "Start (0-based)" },
              { "field": "end", "title": "End (exclusive)" }
            ]
          }
        },
        {
          "mark": { "type": "text", "fontSize": 9, "dy": -9, "color": "#333333", "paddingX": 3 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus" },
            "x2": { "chrom": "chrom", "pos": "end" },
            "text": { "field": "name" }
          }
        }
      ]
    },
    {
      "name": "genes",
      "title": {
        "text": "GENCODE M21 genes",
        "style": "track-title"
      },
      "description": "Gene models overlapping the four retained regions; coordinates are converted from GTF one-based inclusive to zero-based half-open.",
      "height": 28,
      "data": { "url": "../output/genes.tsv" },
      "layer": [
        {
          "mark": { "type": "rect", "color": "#8c8c8c", "height": 5 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus", "axis": null },
            "x2": { "chrom": "chrom", "pos": "end" },
            "tooltip": [
              { "field": "symbol", "title": "Gene" },
              { "field": "geneId", "title": "GENCODE ID" },
              { "field": "strand", "title": "Strand" }
            ]
          }
        },
        {
          "mark": { "type": "text", "fontSize": 9, "dy": -8, "color": "#4d4d4d", "paddingX": 3 },
          "encoding": {
            "x": { "chrom": "chrom", "pos": "start", "type": "locus" },
            "x2": { "chrom": "chrom", "pos": "end" },
            "text": { "field": "symbol" }
          }
        }
      ]
    },
    {
      "name": "samples",
      "title": "H3K27ac fold change over control",
      "description": "Each row is one biological replicate. Every row uses the same fixed 0-60 linear scale, including when bookmarks filter samples.",
      "stickySummaries": true,
      "samples": {
        "identity": {
          "data": { "url": "../output/samples.tsv" },
          "idField": "sampleId",
          "displayNameField": "rowLabel"
        },
        "labelTitle": "Sample"
      },
      "sampleLayout": {
        "sampleHeight": 20,
        "groupSpacing": 5,
        "peekGroupSpacing": 9,
        "sampleSpacingFactor": 0.06
      },
      "sampleYAxis": { "mode": "top", "minSampleHeight": 18 },
      "metadata": {
        "title": "RNA-seq tissue-stage means and provenance",
        "attributeWidth": 15,
        "missingValueColor": "#bdbdbd",
        "sources": [
          {
            "id": "fetal-tissues",
            "name": "Mouse fetal tissue panel",
            "description": "Expression values are log2(mean TPM + 1) from two condition-matched bulk RNA-seq replicates and are intentionally shared by both H3K27ac rows in the same tissue-stage.",
            "initialLoad": "*",
            "excludeColumns": ["rowLabel"],
            "backend": {
              "backend": "data",
              "data": { "url": "../output/samples.tsv" },
              "sampleIdField": "sampleId"
            },
            "attributes": {
              "tissue": {
                "title": "Tissue",
                "type": "ordinal",
                "scale": {
                  "type": "ordinal",
                  "domain": ["Forebrain", "Heart", "Limb"],
                  "range": ["#4e79a7", "#e15759", "#59a14f"]
                }
              },
              "stageDays": { "title": "Embryonic age", "type": "quantitative", "visible": false },
              "stageLabel": {
                "title": "Stage",
                "type": "ordinal",
                "scale": {
                  "type": "ordinal",
                  "domain": ["E11.5", "E12.5", "E13.5", "E15.5"],
                  "range": ["#f0f0f0", "#bdbdbd", "#737373", "#252525"]
                }
              },
              "chipBiologicalReplicate": {
                "title": "ChIP rep",
                "type": "ordinal",
                "scale": { "type": "ordinal", "domain": [1, 2], "range": ["#9ecae1", "#3182bd"] }
              },
              "chipTechnicalReplicate": { "title": "Technical run(s)", "type": "nominal", "visible": false },
              "chipBiosample": { "title": "ChIP biosample", "type": "nominal", "visible": false },
              "chipExperiment": { "title": "ChIP experiment", "type": "nominal", "visible": false },
              "chipFileAccession": { "title": "ChIP file", "type": "nominal", "visible": false },
              "strain": { "title": "Strain", "type": "nominal", "visible": false },
              "preparation": { "title": "Preparation", "type": "nominal", "visible": false },
              "signal": { "title": "Signal", "type": "nominal", "visible": false },
              "expressionJoin": { "title": "RNA join", "type": "nominal", "visible": false },
              "rnaExperiment": { "title": "RNA experiment", "type": "nominal", "visible": false },
              "rnaReplicateCount": { "title": "RNA n", "type": "quantitative", "visible": false },
              "rnaFileAccessions": { "title": "RNA files", "type": "nominal", "visible": false },
              "Ascl1": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Ckb": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Foxg1": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Tnnt2": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Nkx2-5": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Hand2": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Prrx1": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Myog": { "type": "quantitative", "scale": { "scheme": "blues", "domain": [0, 12] }, "description": "RNA-seq tissue-stage mean; log2(mean TPM + 1)." },
              "Ascl1MeanTpm": { "title": "Ascl1 TPM", "type": "quantitative", "visible": false },
              "CkbMeanTpm": { "title": "Ckb TPM", "type": "quantitative", "visible": false },
              "Foxg1MeanTpm": { "title": "Foxg1 TPM", "type": "quantitative", "visible": false },
              "Tnnt2MeanTpm": { "title": "Tnnt2 TPM", "type": "quantitative", "visible": false },
              "Nkx2-5MeanTpm": { "title": "Nkx2-5 TPM", "type": "quantitative", "visible": false },
              "Hand2MeanTpm": { "title": "Hand2 TPM", "type": "quantitative", "visible": false },
              "Prrx1MeanTpm": { "title": "Prrx1 TPM", "type": "quantitative", "visible": false },
              "MyogMeanTpm": { "title": "Myog TPM", "type": "quantitative", "visible": false }
            }
          }
        ]
      },
      "spec": {
        "name": "h3k27ac-signal",
        "height": 20,
        "view": { "fill": "black", "fillOpacity": 0.025 },
        "data": {
          "lazy": {
            "type": "bigwig",
            "url": {
              "template": "../output/bigwigs/{sampleId}.bigWig",
              "values": { "expr": "visibleSamples" },
              "field": "sampleId",
              "maxValues": 24
            },
            "pixelsPerBin": 1
          }
        },
        "transform": [
          { "type": "filter", "expr": "isValid(datum.score) && datum.score >= 0" }
        ],
        "mark": { "type": "rect", "color": "#4c78a8", "minWidth": 0.5 },
        "encoding": {
          "sample": { "field": "sampleId" },
          "x": {
            "chrom": "chrom",
            "pos": "start",
            "type": "locus",
            "axis": { "grid": true, "gridColor": "#eeeeee", "chromGrid": true }
          },
          "x2": { "chrom": "chrom", "pos": "end" },
          "y": {
            "field": "score",
            "type": "quantitative",
            "scale": { "domain": [0, 60], "zero": true },
            "axis": { "title": "Fold change", "titleFit": "range" }
          },
          "tooltip": [
            { "field": "sampleId", "title": "H3K27ac row" },
            { "field": "score", "title": "Fold change", "format": ".4g" }
          ]
        }
      }
    }
  ],
  "config": {
    "style": { "group-title": { "orient": "none" } },
    "legendTrack": { "disable": true }
  }
}

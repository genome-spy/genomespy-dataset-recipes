{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",
  "description": "Compact Wakhan segment features, currently loss of heterozygosity.",
  "name": "segment-features",
  "height": 12,
  "title": {
    "text": "Wakhan LOH calls",
    "anchor": "start",
    "fontSize": 11,
    "color": "#364653",
    "offset": 5
  },
  "layer": [
    {
      "name": "loh-unavailable",
      "data": {
        "url": "../output/unavailable-cn.tsv"
      },
      "mark": {
        "type": "rect",
        "color": "#edf0f2",
        "clip": "x"
      },
      "encoding": {
        "x": {
          "chrom": "chrom",
          "pos": "start",
          "type": "locus",
          "band": 0
        },
        "x2": {
          "chrom": "chrom",
          "pos": "end",
          "band": 0
        },
        "tooltip": [{ "field": "status", "title": "Availability" }]
      }
    },
    {
      "name": "loh-blacklist",
      "import": {
        "url": "blacklist.json"
      }
    },
    {
      "name": "loh-segments",
      "data": {
        "url": "../output/loh-segments.tsv"
      },
      "mark": {
        "type": "rect",
        "opacity": 0.78,
        "strokeWidth": 0.5,
        "clip": "x"
      },
      "encoding": {
        "fill": {
          "condition": {
            "param": "svRegion",
            "empty": true,
            "value": "#6195b9"
          },
          "value": "#8f999e"
        },
        "stroke": {
          "condition": {
            "param": "svRegion",
            "empty": true,
            "value": "#417497"
          },
          "value": "#768187"
        },
        "x": {
          "chrom": "chrom",
          "pos": "start",
          "type": "locus",
          "band": 0
        },
        "x2": {
          "chrom": "chrom",
          "pos": "end",
          "band": 0
        },
        "tooltip": [
          { "field": "feature", "title": "Feature" },
          { "field": "basis", "title": "Basis" },
          {
            "expr": "'Not supplied by Wakhan LOH BED'",
            "title": "Confidence"
          }
        ]
      }
    }
  ]
}

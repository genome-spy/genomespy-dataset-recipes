{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",
  "description": [
    "HCC1954 \u00b7 a chromosome-local view",
    "Matched Wakhan / CASTLE HiFi outputs. HP1 and HP2 are arbitrary within each chromosome, not parental identities."
  ],
  "assembly": "hg38",
  "padding": {
    "left": 10,
    "right": 18,
    "top": 8,
    "bottom": 5
  },
  "width": "container",
  "spacing": 10,
  "params": [
    {
      "name": "showRuler",
      "value": true,
      "description": "Show a vertical genomic ruler across the linked detail tracks.",
      "bind": { "input": "checkbox", "name": "Show ruler" }
    },
    {
      "name": "brush"
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#6b7c85",
      "domainColor": "#ced6da",
      "tickColor": "#ced6da",
      "gridColor": "#e9edef",
      "grid": false
    },
    "axisLocus": {
      "chromGrid": true,
      "chromGridColor": "#e0e6e9",
      "chromGridOpacity": 0.6,
      "title": null
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10
    }
  },
  "vconcat": [
    {
      "import": {
        "url": "genome-navigator.json"
      }
    },
    {
      "name": "detail",
      "spacing": 12,
      "params": [
        {
          "name": "genomicCursor",
          "persist": false,
          "ruler": {
            "disabled": { "expr": "!showRuler" },
            "encodings": ["x"],
            "extent": "container",
            "display": "line",
            "mark": {
              "stroke": "#6b7c85",
              "strokeWidth": 1,
              "strokeDash": [3, 3],
              "opacity": {
                "expr": "pointerOverSvRegion ? 0 : 0.75"
              }
            }
          }
        },
        {
          "name": "svRegion",
          "persist": false,
          "select": {
            "type": "interval",
            "encodings": ["x"],
            "extent": "container",
            "on": "mousedown[event.shiftKey]",
            "clear": "dblclick",
            "zoom": false,
            "mark": {
              "stroke": "#487d91",
              "strokeOpacity": 0.65,
              "strokeWidth": 1,
              "fillOpacity": 0,
              "measure": "inside"
            }
          }
        },
        {
          "name": "pointerOverSvRegion",
          "expr": "genomicCursor.values.x != null && svRegion.intervals.x != null && linearize('x', genomicCursor.values.x) >= svRegion.intervals.x[0] && linearize('x', genomicCursor.values.x) <= svRegion.intervals.x[1]",
          "description": "Whether the genomic pointer is inside the active SV interval selection. Used to suppress rulers while the brush is under the pointer."
        }
      ],
      "resolve": {
        "scale": { "x": "shared" },
        "axis": { "x": "shared" }
      },
      "vconcat": [
        {
          "import": { "url": "structural-variants.json" }
        },
        {
          "import": { "url": "copy-number.json" }
        },
        {
          "import": { "url": "baf.json" }
        },
        {
          "import": { "url": "cytobands.json" }
        },
        {
          "import": { "url": "selected-genes.json" }
        }
      ]
    }
  ]
}

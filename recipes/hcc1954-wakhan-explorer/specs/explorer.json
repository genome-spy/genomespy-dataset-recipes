{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",
  "description": [
    "HCC1954 \u00b7 a chromosome-local view",
    "Matched Wakhan / CASTLE HiFi outputs. HP1 and HP2 are arbitrary within each chromosome, not parental identities."
  ],
  "assembly": "hg38",
  "padding": {
    "left": 10,
    "right": 18,
    "top": 8,
    "bottom": 5
  },
  "width": "container",
  "spacing": 12,
  "params": [
    {
      "name": "brush"
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#6b7c85",
      "domainColor": "#ced6da",
      "tickColor": "#ced6da",
      "gridColor": "#e9edef",
      "grid": false
    },
    "axisLocus": {
      "chromGrid": true,
      "chromGridColor": "#e0e6e9",
      "chromGridOpacity": 0.6,
      "title": null
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10
    }
  },
  "vconcat": [
    {
      "name": "overview",
      "resolve": {
        "scale": {
          "x": "excluded"
        }
      },
      "height": 25,
      "title": {
        "text": "Genome navigator | double-click, then drag to brush; scroll to resize; drag selection to move",
        "anchor": "start",
        "fontSize": 11,
        "color": "#364653",
        "offset": 5
      },
      "data": {
        "lazy": {
          "type": "axisGenome",
          "channel": "x"
        }
      },
      "view": {
        "stroke": "#ccd4d8"
      },
      "encoding": {
        "x": {
          "field": "continuousStart",
          "type": "locus",
          "scale": {
            "zoom": false
          },
          "axis": null
        },
        "x2": {
          "field": "continuousEnd"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "tooltip": null,
            "clip": true
          },
          "encoding": {
            "color": {
              "field": "odd",
              "type": "nominal",
              "scale": {
                "domain": [true, false],
                "range": ["#e4e9ec", "#f7f9fa"]
              },
              "legend": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "size": 11,
            "color": "#4a5c68",
            "paddingX": 2,
            "tooltip": null
          },
          "encoding": {
            "text": {
              "field": "name"
            }
          }
        }
      ],
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": ["x"],
            "mark": {
              "stroke": "#487d91",
              "strokeWidth": 1.5,
              "fill": "#75adbf",
              "fillOpacity": 0.1,
              "zindex": 11,
              "clip": false
            },
            "clear": "dblclick"
          },
          "push": "outer",
          "persist": false
        }
      ]
    },
    {
      "name": "detail",
      "spacing": 12,
      "params": [
        {
          "name": "genomicCursor",
          "persist": false,
          "ruler": {
            "encodings": ["x"],
            "extent": "container",
            "display": "line",
            "mark": {
              "stroke": "#6b7c85",
              "strokeWidth": 1,
              "strokeDash": [3, 3],
              "opacity": 0.75
            }
          }
        },
        {
          "name": "svRegion",
          "persist": false,
          "select": {
            "type": "interval",
            "encodings": ["x"],
            "extent": "container",
            "on": "mousedown[event.shiftKey]",
            "clear": "dblclick",
            "zoom": false,
            "mark": {
              "stroke": "#487d91",
              "strokeOpacity": 0.65,
              "strokeWidth": 1,
              "fillOpacity": 0,
              "measure": "inside"
            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "x": "shared"
        },
        "axis": {
          "x": "shared"
        }
      },
      "vconcat": [
        {
          "name": "structural-variants",
          "height": 110,
          "title": {
            "text": "Structural variants | Shift-drag a region; hover or click an arc",
            "anchor": "start",
            "fontSize": 11,
            "color": "#364653",
            "offset": 5
          },
          "data": {
            "url": "../output/sv-links.tsv",
            "format": {
              "parse": {
                "genotype": "string",
                "haplotype": "string",
                "phaseSet": "string",
                "variantId": "string",
                "mateId": "string"
              }
            }
          },
          "transform": [
            {
              "type": "linearizeGenomicCoordinate",
              "chrom": "chrom1",
              "pos": "start1",
              "as": "_x1"
            },
            {
              "type": "linearizeGenomicCoordinate",
              "chrom": "chrom2",
              "pos": "start2",
              "as": "_x2"
            },
            {
              "type": "formula",
              "expr": "abs(datum._x2 - datum._x1)",
              "as": "svSpan"
            },
            {
              "type": "identifier"
            }
          ],
          "encoding": {
            "color": {
              "field": "svType",
              "type": "nominal",
              "scale": {
                "domain": ["BND", "DEL", "DUP", "INS", "sBND"],
                "range": ["#627785", "#3d70a0", "#b96e43", "#7c6b95", "#9a9e9f"]
              },
              "legend": {
                "title": "SV class",
                "orient": "top",
                "direction": "horizontal"
              }
            }
          },
          "layer": [
            {
              "name": "sv-feet",
              "transform": [
                {
                  "type": "regexFold",
                  "columnRegex": ["^chrom(1|2)$", "^start(1|2)$"],
                  "asValue": ["chrom", "start"],
                  "asKey": "endpoint"
                },
                {
                  "type": "formula",
                  "expr": "datum.orientation[datum.endpoint - 1]",
                  "as": "strand"
                }
              ],
              "mark": {
                "type": "rule",
                "y": 0,
                "yOffset": -0.5,
                "clip": "x",
                "size": 1,
                "opacity": 0.28
              },
              "encoding": {
                "x": {
                  "chrom": "chrom",
                  "pos": "start",
                  "type": "locus",
                  "band": 0
                },
                "x2": {
                  "chrom": "chrom",
                  "pos": "start",
                  "band": 0
                },
                "xOffset": {
                  "field": "strand",
                  "type": "nominal",
                  "scale": {
                    "name": "svFootOffset",
                    "domain": ["-", "+"],
                    "range": [
                      {
                        "expr": "clamp(7 * 100000000 / span(domain('x')), 1, 7)"
                      },
                      {
                        "expr": "-clamp(7 * 100000000 / span(domain('x')), 1, 7)"
                      }
                    ],
                    "type": "ordinal"
                  },
                  "legend": null
                },
                "tooltip": [
                  {
                    "field": "variantId",
                    "title": "Original variant ID"
                  },
                  {
                    "field": "svType",
                    "title": "SV type"
                  },
                  {
                    "expr": "datum.chrom + ':' + datum['position' + datum.endpoint]",
                    "title": "Breakpoint (VCF, 1-based)"
                  },
                  {
                    "field": "strand",
                    "title": "Strand"
                  }
                ]
              }
            },
            {
              "name": "sv-domes",
              "mark": {
                "type": "link",
                "linkShape": "dome",
                "maxChordLength": 100000000,
                "yOffset": -4,
                "y2Offset": 0,
                "segments": 200,
                "minPickingSize": 5,
                "clip": true
              },
              "encoding": {
                "x": {
                  "chrom": "chrom1",
                  "pos": "start1",
                  "type": "locus",
                  "band": 0,
                  "scale": {
                    "name": "genome",
                    "domain": {
                      "param": "brush",
                      "initial": [
                        {
                          "chrom": "chr1",
                          "pos": 0
                        },
                        {
                          "chrom": "chrY",
                          "pos": 57227415
                        }
                      ]
                    }
                  }
                },
                "x2": {
                  "chrom": "chrom2",
                  "pos": "start2",
                  "band": 0
                },
                "y": {
                  "field": "svSpan",
                  "type": "quantitative",
                  "scale": {
                    "name": "svDomeHeight",
                    "type": "sqrt",
                    "domain": {
                      "expr": "[0, span(domain('x')) * height / width * 5]"
                    }
                  },
                  "axis": null
                },
                "y2": {
                  "value": 0
                },
                "tooltip": [
                  {
                    "field": "svType",
                    "title": "SV type"
                  },
                  {
                    "field": "variantId",
                    "title": "Original variant ID"
                  },
                  {
                    "field": "mateId",
                    "title": "Mate ID"
                  },
                  {
                    "field": "orientation",
                    "title": "Strands"
                  },
                  {
                    "field": "haplotype",
                    "title": "Source HP"
                  },
                  {
                    "field": "phaseSet",
                    "title": "Phase set"
                  },
                  {
                    "field": "genotype",
                    "title": "Target genotype"
                  },
                  {
                    "field": "variantReads",
                    "title": "Variant reads"
                  },
                  {
                    "field": "referenceReads",
                    "title": "Reference reads"
                  },
                  {
                    "field": "vaf",
                    "title": "VAF"
                  },
                  {
                    "field": "haplotypeVaf",
                    "title": "Haplotype VAF"
                  },
                  {
                    "field": "detailedType",
                    "title": "Severus detail"
                  }
                ],
                "size": {
                  "condition": [
                    {
                      "param": "svRegion",
                      "empty": false,
                      "value": 2
                    },
                    {
                      "param": "svHover",
                      "empty": false,
                      "value": 2.8
                    },
                    {
                      "param": "svSelect",
                      "empty": false,
                      "value": 2.8
                    }
                  ],
                  "value": 1
                },
                "opacity": {
                  "condition": {
                    "param": "svRegion",
                    "empty": true,
                    "expr": "svHover.uniqueId == datum.__uniqueId || mapHasKey(svSelect.data, datum.__uniqueId) ? 1 : svSelect.data.size ? 0.035 : 0.28",
                    "type": "quantitative",
                    "scale": null
                  },
                  "value": 0.1
                }
              },
              "params": [
                {
                  "name": "svHover",
                  "select": {
                    "type": "point",
                    "on": "pointerover"
                  },
                  "persist": false
                },
                {
                  "name": "svSelect",
                  "select": "point",
                  "persist": false
                }
              ]
            }
          ]
        },
        {
          "name": "single-sites",
          "height": 10,
          "data": {
            "url": "../output/sv-sites.tsv",
            "format": {
              "parse": {
                "genotype": "string",
                "haplotype": "string",
                "phaseSet": "string",
                "variantId": "string",
                "mateId": "string"
              }
            }
          },
          "mark": {
            "type": "point",
            "shape": "triangle-up",
            "size": 18,
            "opacity": 0.7
          },
          "encoding": {
            "x": {
              "chrom": "chrom1",
              "pos": "start1",
              "type": "locus",
              "band": 0
            },
            "y": {
              "value": 0.5
            },
            "color": {
              "field": "svType",
              "type": "nominal",
              "scale": {
                "domain": ["BND", "DEL", "DUP", "INS", "sBND"],
                "range": ["#627785", "#3d70a0", "#b96e43", "#7c6b95", "#9a9e9f"]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "svType",
                "title": "SV type"
              },
              {
                "field": "variantId",
                "title": "Original variant ID"
              },
              {
                "field": "orientation",
                "title": "Strands"
              },
              {
                "field": "haplotype",
                "title": "Source HP"
              },
              {
                "field": "phaseSet",
                "title": "Phase set"
              },
              {
                "field": "genotype",
                "title": "Target genotype"
              },
              {
                "field": "variantReads",
                "title": "Variant reads"
              },
              {
                "field": "referenceReads",
                "title": "Reference reads"
              },
              {
                "field": "vaf",
                "title": "VAF"
              },
              {
                "field": "haplotypeVaf",
                "title": "Haplotype VAF"
              },
              {
                "field": "detailedType",
                "title": "Severus detail"
              }
            ]
          }
        },
        {
          "name": "copy-number",
          "params": [
            {
              "name": "singleCopyDepth",
              "value": 14.012,
              "description": "Expected read-depth increase per additional inferred copy, from the selected Wakhan solution's run log."
            },
            {
              "name": "depthOffset",
              "value": 0.1,
              "description": "Read-depth intercept at zero inferred copies, from the archived Plotly CN-axis calibration: depth = singleCopyDepth * copies + depthOffset."
            }
          ],
          "spacing": 13,
          "resolve": {
            "scale": {
              "y": "shared"
            },
            "axis": {
              "x": "shared"
            }
          },
          "vconcat": [
            {
              "name": "cn-hp1",
              "import": {
                "template": "cn"
              },
              "params": {
                "hp": "HP1",
                "ink": "firebrick",
                "binInk": "#cd6f6f"
              }
            },
            {
              "name": "cn-hp2",
              "import": {
                "template": "cn"
              },
              "params": {
                "hp": "HP2",
                "ink": "steelblue",
                "binInk": "#87aece"
              }
            }
          ],
          "data": {
            "values": [{}]
          },
          "transform": [
            {
              "type": "formula",
              "expr": "domain('y')[0] * singleCopyDepth + depthOffset",
              "as": "depthMin"
            },
            {
              "type": "formula",
              "expr": "domain('y')[1] * singleCopyDepth + depthOffset",
              "as": "depthMax"
            }
          ]
        },
        {
          "name": "baf",
          "height": 67,
          "title": {
            "text": "Folded BAF | 50 kb means | grey zeros have unknown SNP support",
            "anchor": "start",
            "fontSize": 11,
            "color": "#364653",
            "offset": 5
          },
          "layer": [
            {
              "data": {
                "values": [0.25, 0.5]
              },
              "mark": {
                "type": "rule",
                "color": "#d8e0e1",
                "strokeDash": [3, 3],
                "tooltip": null
              },
              "encoding": {
                "y": {
                  "field": "data",
                  "type": "quantitative"
                }
              }
            },
            {
              "data": {
                "url": "../output/coverage-baf.tsv"
              },
              "mark": {
                "type": "point",
                "size": {
                  "expr": "min(1 * pow(zoomLevel, 1.5), 100)"
                },
                "opacity": 0.25,
                "strokeWidth": 0,
                "color": "#428b81",
                "clip": "x"
              },
              "encoding": {
                "x": {
                  "chrom": "chrom",
                  "pos": "start",
                  "type": "locus",
                  "band": 0
                },
                "x2": {
                  "chrom": "chrom",
                  "pos": "end",
                  "band": 0
                },
                "y": {
                  "field": "baf",
                  "type": "quantitative",
                  "scale": {
                    "domain": [0, 0.5]
                  },
                  "axis": {
                    "title": null,
                    "values": [0, 0.25, 0.5]
                  }
                },
                "tooltip": [
                  {
                    "field": "chrom",
                    "title": "Chromosome"
                  },
                  {
                    "field": "sourceStart",
                    "title": "Original Wakhan start",
                    "format": ",d"
                  },
                  {
                    "field": "end",
                    "title": "End",
                    "format": ",d"
                  },
                  {
                    "field": "baf",
                    "title": "Folded BAF",
                    "format": ".3f"
                  },
                  {
                    "field": "bafStatus",
                    "title": "Interpretation"
                  }
                ]
              },
              "transform": [
                {
                  "type": "filter",
                  "expr": "datum.baf > 0"
                }
              ]
            },
            {
              "data": {
                "url": "../output/coverage-baf.tsv"
              },
              "mark": {
                "type": "point",
                "size": {
                  "expr": "min(1 * pow(zoomLevel, 1.5), 100)"
                },
                "opacity": 0.25,
                "strokeWidth": 0,
                "color": "#aeb8bd",
                "shape": "cross",
                "clip": "x"
              },
              "encoding": {
                "x": {
                  "chrom": "chrom",
                  "pos": "start",
                  "type": "locus",
                  "band": 0
                },
                "x2": {
                  "chrom": "chrom",
                  "pos": "end",
                  "band": 0
                },
                "y": {
                  "field": "baf",
                  "type": "quantitative",
                  "scale": {
                    "domain": [0, 0.5]
                  },
                  "axis": {
                    "title": null,
                    "values": [0, 0.25, 0.5]
                  }
                },
                "tooltip": [
                  {
                    "field": "chrom",
                    "title": "Chromosome"
                  },
                  {
                    "field": "sourceStart",
                    "title": "Original Wakhan start",
                    "format": ",d"
                  },
                  {
                    "field": "end",
                    "title": "End",
                    "format": ",d"
                  },
                  {
                    "field": "baf",
                    "title": "Folded BAF",
                    "format": ".3f"
                  },
                  {
                    "field": "bafStatus",
                    "title": "Interpretation"
                  }
                ]
              },
              "transform": [
                {
                  "type": "filter",
                  "expr": "datum.baf == 0"
                }
              ]
            }
          ]
        },
        {
          "name": "cytobands",
          "height": 16,
          "data": {
            "url": "../output/cytobands.tsv"
          },
          "mark": {
            "type": "rect",
            "minWidth": 0.3
          },
          "encoding": {
            "x": {
              "chrom": "chrom",
              "pos": "start",
              "type": "locus",
              "band": 0
            },
            "x2": {
              "chrom": "chrom",
              "pos": "end",
              "band": 0
            },
            "color": {
              "field": "stain",
              "type": "nominal",
              "scale": {
                "domain": [
                  "gneg",
                  "gpos25",
                  "gpos50",
                  "gpos75",
                  "gpos100",
                  "acen",
                  "gvar",
                  "stalk"
                ],
                "range": [
                  "#f3f5f5",
                  "#dce1e3",
                  "#bdc6ca",
                  "#939fa5",
                  "#64747c",
                  "#c3988d",
                  "#e1e5e6",
                  "#d8dddd"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "chrom",
                "title": "Chromosome"
              },
              {
                "field": "band",
                "title": "Cytoband"
              },
              {
                "expr": "format(datum.start + 1, \",d\")",
                "title": "Start (1-based)"
              },
              {
                "field": "end",
                "title": "End",
                "format": ",d"
              }
            ]
          }
        },
        {
          "name": "genes",
          "title": {
            "text": "Selected cancer genes | RefSeq / GRCh38",
            "anchor": "start",
            "fontSize": 11,
            "color": "#364653",
            "offset": 5
          },
          "height": 25,
          "data": {
            "url": "../output/genes.tsv"
          },
          "encoding": {
            "x": {
              "chrom": "chrom",
              "pos": "start",
              "type": "locus",
              "band": 0
            },
            "x2": {
              "chrom": "chrom",
              "pos": "end",
              "band": 0
            },
            "tooltip": [
              {
                "field": "symbol",
                "title": "Gene"
              },
              {
                "field": "chrom",
                "title": "Chromosome"
              },
              {
                "expr": "format(datum.start + 1, \",d\")",
                "title": "Start (1-based)"
              },
              {
                "field": "end",
                "title": "End",
                "format": ",d"
              },
              {
                "field": "strand",
                "title": "Strand"
              },
              {
                "title": "Annotation",
                "expr": "\"Union of curated protein-coding RefSeq transcripts\""
              }
            ]
          },
          "layer": [
            {
              "mark": {
                "type": "rect",
                "color": "#64747c",
                "y": 0.1,
                "y2": 0.3,
                "minWidth": 2
              }
            },
            {
              "transform": [
                {
                  "type": "linearizeGenomicCoordinate",
                  "chrom": "chrom",
                  "pos": "start",
                  "as": "_pos"
                },
                {
                  "type": "formula",
                  "expr": "datum.symbol == 'MYC' || datum.symbol == 'ERBB2' || datum.symbol == 'TERT' ? 10 : 1",
                  "as": "score"
                },
                {
                  "type": "formula",
                  "expr": "0",
                  "as": "lane"
                },
                {
                  "type": "measureText",
                  "field": "symbol",
                  "fontSize": 10,
                  "as": "_width"
                },
                {
                  "type": "filterScoredLabels",
                  "lane": "lane",
                  "score": "score",
                  "width": "_width",
                  "pos": "_pos",
                  "padding": 12
                }
              ],
              "mark": {
                "type": "text",
                "size": 10,
                "color": "#425560",
                "y": 0.75,
                "align": "center"
              },
              "encoding": {
                "x2": null,
                "text": {
                  "field": "symbol"
                },
                "opacity": {
                  "expr": "datum.score == 10 || zoomLevel > 5 ? 1 : 0",
                  "type": "quantitative",
                  "scale": null
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "templates": {
    "blacklist": {
      "data": {
        "url": "../output/masked-regions.tsv"
      },
      "mark": {
        "type": "rect",
        "fill": "#f7f9fa",
        "stroke": "#dce2e4",
        "strokeWidth": 1,
        "hatch": "diagonal",
        "clip": "x"
      },
      "encoding": {
        "x": {
          "chrom": "chrom",
          "pos": "start",
          "type": "locus",
          "band": 0
        },
        "x2": {
          "chrom": "chrom",
          "pos": "end",
          "band": 0
        },
        "tooltip": [
          {
            "field": "chrom",
            "title": "Chromosome"
          },
          {
            "expr": "format(datum.start + 1, \",d\")",
            "title": "Start (1-based)"
          },
          {
            "field": "end",
            "title": "End",
            "format": ",d"
          },
          {
            "field": "status",
            "title": "Availability"
          }
        ]
      }
    },
    "cn": {
      "height": 105,
      "params": [
        {
          "name": "hp",
          "value": "HP1"
        },
        {
          "name": "ink",
          "value": "firebrick"
        },
        {
          "name": "binInk",
          "value": "#cd6f6f",
          "description": "Lighter haplotype colour for raw coverage bins; inferred CN uses ink."
        }
      ],
      "title": {
        "text": {
          "expr": "hp + ' | copy number + binned read depth'"
        },
        "anchor": "start",
        "fontSize": 11,
        "color": "#364653",
        "offset": 5
      },
      "layer": [
        {
          "name": "cn-unavailable",
          "data": {
            "url": "../output/unavailable-cn.tsv"
          },
          "mark": {
            "type": "rect",
            "color": "#edf0f2"
          },
          "encoding": {
            "x": {
              "chrom": "chrom",
              "pos": "start",
              "type": "locus",
              "band": 0
            },
            "x2": {
              "chrom": "chrom",
              "pos": "end",
              "band": 0
            },
            "tooltip": [
              {
                "field": "chrom",
                "title": "Chromosome"
              },
              {
                "field": "start",
                "title": "Start (0-based)",
                "format": ",d"
              },
              {
                "field": "end",
                "title": "End",
                "format": ",d"
              },
              {
                "field": "status",
                "title": "Availability"
              }
            ]
          }
        },
        {
          "name": "cn-blacklist",
          "import": {
            "template": "blacklist"
          }
        },
        {
          "name": "coverage",
          "description": "The invisible interval supplies calibrated bounds from the shared CN scale. Raw bins do not contribute to these bounds.",
          "resolve": {
            "scale": {
              "y": "excluded"
            }
          },
          "layer": [
            {
              "name": "coverage-domain",
              "mark": {
                "type": "rule",
                "opacity": 0,
                "tooltip": null
              },
              "encoding": {
                "x": {
                  "value": 0
                },
                "y": {
                  "field": "depthMin",
                  "type": "quantitative"
                },
                "y2": {
                  "field": "depthMax"
                }
              }
            },
            {
              "name": "cn-baseline",
              "data": { "values": [{}] },
              "mark": {
                "type": "rule",
                "color": "#d8e0e1",
                "clip": false
              },
              "encoding": {
                "y": { "datum": 0, "type": "quantitative" }
              }
            },
            {
              "name": "coverage-bins",
              "data": {
                "url": "../output/coverage-baf.tsv"
              },
              "transform": [
                {
                  "type": "filter",
                  "expr": "datum.coverageStatus == 'reported'"
                },
                {
                  "type": "formula",
                  "expr": "hp == 'HP1' ? datum.hp1 : datum.hp2",
                  "as": "depth"
                }
              ],
              "mark": {
                "type": "point",
                "size": {
                  "expr": "min(1 * pow(zoomLevel, 1.5) + 2, 100)"
                },
                "color": {
                  "expr": "binInk"
                },
                "opacity": 0.25,
                "strokeWidth": 0,
                "clip": true
              },
              "encoding": {
                "x": {
                  "chrom": "chrom",
                  "pos": "start",
                  "type": "locus",
                  "band": 0
                },
                "x2": {
                  "chrom": "chrom",
                  "pos": "end",
                  "band": 0
                },
                "y": {
                  "field": "depth",
                  "type": "quantitative",
                  "scale": {
                    "type": "linear",
                    "nice": false,
                    "zero": false,
                    "domainTransition": false,
                    "clamp": false
                  },
                  "axis": {
                    "orient": "right",
                    "title": "Read depth",
                    "tickCount": 4
                  }
                },
                "tooltip": [
                  {
                    "field": "chrom",
                    "title": "Chromosome"
                  },
                  {
                    "field": "sourceStart",
                    "title": "Original Wakhan start",
                    "format": ",d"
                  },
                  {
                    "field": "end",
                    "title": "End",
                    "format": ",d"
                  },
                  {
                    "expr": "hp",
                    "title": "Chromosome-local haplotype"
                  },
                  {
                    "field": "depth",
                    "title": "Reported depth",
                    "format": ".2f"
                  },
                  {
                    "title": "Resolution",
                    "expr": "\"50 kb bins; terminal bins truncated to GRCh38\""
                  }
                ]
              },
              "domainInert": true
            }
          ]
        },
        {
          "name": "cn-segments",
          "data": {
            "url": "../output/copy-number-segments.tsv"
          },
          "transform": [
            {
              "type": "filter",
              "expr": "datum.haplotype == hp"
            }
          ],
          "mark": {
            "type": "rule",
            "color": {
              "expr": "ink"
            },
            "size": 3,
            "minLength": 1,
            "clip": "x"
          },
          "encoding": {
            "x": {
              "chrom": "chrom",
              "pos": "start",
              "type": "locus",
              "band": 0
            },
            "x2": {
              "chrom": "chrom",
              "pos": "end",
              "band": 0
            },
            "y": {
              "field": "copyNumber",
              "type": "quantitative",
              "scale": {
                "domain": {
                  "source": "viewport"
                },
                "zero": true,
                "nice": true,
                "name": "copyNumber",
                "clamp": true
              },
              "axis": {
                "title": "Copies",
                "tickCount": 4,
                "tickMinStep": 1
              }
            },
            "tooltip": [
              {
                "field": "chrom",
                "title": "Chromosome"
              },
              {
                "field": "sourceStart",
                "title": "Original Wakhan start",
                "format": ",d"
              },
              {
                "field": "end",
                "title": "End",
                "format": ",d"
              },
              {
                "field": "haplotype",
                "title": "Chromosome-local haplotype"
              },
              {
                "field": "copyNumber",
                "title": "Inferred copies"
              },
              {
                "field": "confidence",
                "title": "Wakhan CN confidence",
                "format": ".3f"
              },
              {
                "field": "medianCoverage",
                "title": "Segment median depth",
                "format": ".2f"
              },
              {
                "field": "breakpointIds",
                "title": "Source SV annotations"
              }
            ]
          }
        }
      ],
      "resolve": {
        "axis": {
          "y": "independent"
        }
      }
    }
  }
}
